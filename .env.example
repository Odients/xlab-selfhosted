# Copy to .env next to docker-compose.yml. Do not commit .env.
# On Coolify, set the same names on the resource. Mark secrets Literal so $ is not expanded.
# A line in this file does not win when docker-compose.yml sets the same name.

# Registry prefix for api, web, signalr, sendservice, and mssql. Compose pulls tag latest.
# Default in the compose file is the Artifactory release repository.
# XLAB_REGISTRY=artifactory.x-lab.pro/xlab-release

# Public origins. Scheme + host, no path, no trailing slash.
API_PUBLIC_URL=https://api.example.com
WEB_PUBLIC_URL=https://app.example.com
SIGNALR_PUBLIC_URL=https://push.example.com

# Leave empty. The website shows its own login. The API checks Org_Staff.
# SignalR then accepts the API token. Do not point this at xlab-auth.
XLAB_AUTH_URL=

# REST key SendService sends to SignalR as header API-Key. Generate. At least 32 random bytes.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNALR_API_KEY=

# OpenIddict PKCS#12. One line of base64, no wrapping. Not inside the image.
# Every start rewrites /app/cert.pfx from this value.
# Names below are the hosts of API_PUBLIC_URL and SIGNALR_PUBLIC_URL. Replace example.com.
# CHANGE_ME is OPENIDDICT_PFX_PASSWORD. It must not contain $ " or space. Mark the Coolify value Literal.
# openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
#   -keyout cert.key -out cert.crt \
#   -subj "/CN=api.example.com" \
#   -addext "subjectAltName=DNS:api.example.com,DNS:push.example.com"
# openssl pkcs12 -export -out cert.pfx -inkey cert.key -in cert.crt -passout pass:CHANGE_ME
# python -c "import base64,pathlib; print(base64.b64encode(pathlib.Path('cert.pfx').read_bytes()).decode())"
# rm -f cert.key cert.crt cert.pfx
OPENIDDICT_PFX_BASE64=
# Password for that file. Compose passes it to the API and to SignalR.
OPENIDDICT_PFX_PASSWORD=

# Header X-System-Api-Key for SendService calls back to the API. Generate a different value.
XLabApiSettings__Security__SystemApiKey=

# --- SQL Server ---
# At least 8 characters, from three of: uppercase, lowercase, digits, symbols.
# MSSQL_XLAB_PASSWORD is also the API login xlab. Do not use ; or " in it.
MSSQL_SA_PASSWORD=
MSSQL_XLAB_PASSWORD=

# Name|DataFile|LogFile|ApiRole, separated by semicolons.
# Roles: Working, Report. Empty role: attach only, the API does not connect.
# OpenIddict tables are in the Working database.
# MSSQL_DATABASES=XLab|XLab.mdf|XLab_log.ldf|Working;XLabReport|XLabReport.mdf|XLabReport_log.ldf|Report

# Product key. Leave empty for Developer.
# MSSQL_PID=
# MSSQL_MEMORY_LIMIT_MB=2048
# MSSQL_CONTAINER_MEMORY=3g
# MSSQL_SHM_SIZE=1gb
# Host port for SQL Server. The proxy must not publish this.
# MSSQL_PUBLISH_PORT=1433

# --- Offline license (required) ---
# Two lines from the license button (tariff must be self-hosted). Each click replaces both.
# Superuser login and password are not in that file. Set them here.
# Compose does not start without these four values.
# Empty login, empty password, or a bad file stops the API.
# The password is stored only in Org_Staff. This stack does not call xlab-license.
# Do not set LicenseService URL, HMAC, or LicenseServiceClientSecret. Compose clears them.
XLabApiSettings__OfflineLicense__PrivateKey=
XLabApiSettings__OfflineLicense__Document=
XLabApiSettings__OfflineLicense__AdminLogin=
XLabApiSettings__OfflineLicense__AdminPassword=

# --- API (optional) ---
# XLabApiSettings__Security__AccessTokenLifetimeHours=24
# XLabApiSettings__Security__RefreshTokenLifetimeDays=3
# XLabApiSettings__Logging__MinimumLevel=Information

# --- Web browser settings (written to config/xl-env.js at container start) ---
# Compose sets XL_SELF_HOSTED=true and XL_API_URL from API_PUBLIC_URL. Do not set them here.
# The login page posts the password grant to that API. A change needs a new container start, not a new image.

# --- Mail delivered by SendService (Kafka topic email) ---
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_PROTOCOL=TLS
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
