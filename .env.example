# Copy to .env next to docker-compose.yml. Do not commit .env.
# On Coolify, set the same names on the resource. Mark secrets Literal so $ is not expanded.
# A line in this file does not win when docker-compose.yml sets the same name.

# Registry prefix for api, web, signalr, sendservice, and mssql. Compose pulls tag latest.
# Default in the compose file is the Artifactory release repository.
# XLAB_REGISTRY=artifactory.x-lab.pro/xlab-release

# Public origins. Scheme + host, no path, no trailing slash.
API_PUBLIC_URL=https://api.example.com
WEB_PUBLIC_URL=https://app.example.com
SIGNALR_PUBLIC_URL=https://push.example.com
# Hostname only. First name on the SignalR HTTPS certificate. Same host as SIGNALR_PUBLIC_URL.
SIGNALR_PUBLIC_HOST=push.example.com

# xlab-auth origin. No trailing slash. Same value the partner card writes into Prepare .env.
XLAB_AUTH_URL=https://auth.example.com

# Partner card OauthClientId. Public. This is not AppGuid.
XL_OAUTH_CLIENT_ID=

# REST key SendService sends to SignalR as header API-Key. Generate. At least 32 random bytes.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNALR_API_KEY=

# OpenIddict PKCS#12 password. Same file is inside the API image and the SignalR image.
XLabApiSettings__Security__CertificatePassword=

# Header X-System-Api-Key for SendService calls back to the API. Generate a different value.
XLabApiSettings__Security__SystemApiKey=

# --- SQL Server ---
# At least 8 characters, from three of: uppercase, lowercase, digits, symbols.
# MSSQL_XLAB_PASSWORD is also the API login xlab. Do not use ; or " in it.
MSSQL_SA_PASSWORD=
MSSQL_XLAB_PASSWORD=

# Name|DataFile|LogFile|ApiRole, separated by semicolons.
# Roles: Working, License, Report, OpenIddict. Empty role: attach only, the API does not connect.
# MSSQL_DATABASES=XLab|XLab.mdf|XLab_log.ldf|Working;xlab_lic|xlab_lic.mdf|xlab_lic_log.ldf|License;XLabReport|XLabReport.mdf|XLabReport_log.ldf|Report;OAuthDb|OAuthDb.mdf|OAuthDb_log.ldf|OpenIddict

# Product key. Leave empty for Developer.
# MSSQL_PID=
# MSSQL_MEMORY_LIMIT_MB=2048
# MSSQL_CONTAINER_MEMORY=3g
# MSSQL_SHM_SIZE=1gb
# Host port for SQL Server. The proxy must not publish this.
# MSSQL_PUBLISH_PORT=1433

# --- xlab-license Prepare .env (own API) ---
# Paste these five lines from the partner cabinet. Each Prepare replaces the keys.
# XLabApiSettings__XlabAuth__BaseUrl in that file is ignored here: the compose sets it from XLAB_AUTH_URL.
# Do not paste SigningPrivateKey or OauthClientId into this file. OauthClientId is XL_OAUTH_CLIENT_ID above.
XLabApiSettings__Security__LicenseServiceClientSecret=
XLabApiSettings__LicenseService__UseRuntimeProxy=true
XLabApiSettings__LicenseService__BaseUrl=https://license.example.com
XLabApiSettings__LicenseService__HmacKey=
XLabApiSettings__LicenseService__HmacKeyPrevious=

# --- API (optional) ---
# XLabApiSettings__Security__EnableSwagger=false
# XLabApiSettings__Security__AccessTokenLifetimeHours=24
# XLabApiSettings__Security__RefreshTokenLifetimeDays=3
# XLabApiSettings__Logging__MinimumLevel=Information
# XLabApiSettings__Security__Smtp__Host=
# XLabApiSettings__Security__Smtp__Port=587
# XLabApiSettings__Security__Smtp__UseSsl=true
# XLabApiSettings__Security__Smtp__UserName=
# XLabApiSettings__Security__Smtp__Password=
# XLabApiSettings__Security__Smtp__FromEmail=
# XLabApiSettings__Security__Smtp__FromName=X-Lab Support
# XLabApiSettings__ExternalServices__N8N__Url=
# XLabApiSettings__ExternalServices__N8N__ApiKey=

# --- Web browser settings (written to config/xl-env.js at container start) ---
# Empty leaves the feature off. A change needs a new container start, not a new image.
# XL_RECAPTCHA_SITE_KEY=
# XL_GTM_ID=
# XL_DIAGNOSTICS=

# --- Web container (developer-message API). Not visible to the browser. ---
# RECAPTCHA_ENABLED=false
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# KANEO_BASE_URL=
# KANEO_API_KEY=
# KANEO_PROJECT_ID=
# KANEO_STATUS_SLUG=backlog
# UPLOAD_TOKEN_SECRET=

# --- Mail delivered by SendService (Kafka topic email) ---
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_PROTOCOL=TLS
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=

# Firebase service-account JSON on one line. Empty skips real push delivery.
# SendService__Kafka__Topics__0__ProviderSettings__ServiceAccountJson=
